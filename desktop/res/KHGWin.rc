// Windows resources for the desktop launcher (KHGWin.exe): icon and version info.
// The upstream LaunchRes.rc carries the old WinDrv launcher dialogs, which the SDL launcher doesn't use.
#include <winver.h>

#define IDICON_MAINFRAME 128

// Unreal.ico lives in app/src/main/cpp/UE1/Source/Unreal/Src/Res (on the windres include path).
IDICON_MAINFRAME ICON "Unreal.ico"

// Common controls 6 for the launcher window only (KHGLauncher.cpp activates it around the window).
// Resource 2 is not applied to the process by Windows, so the game itself is unaffected.
2 24 "KHGLauncher.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Klingon Honor Guard (Windows desktop port)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "KHGWin"
            VALUE "OriginalFilename", "KHGWin.exe"
            VALUE "ProductName", "KHGA-win"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
